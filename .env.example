# AgentFleet — environment template.
# Copy to .env and fill in your values:   cp .env.example .env
# .env is gitignored — real keys never get committed.

# ── Database & queue (matches docker compose defaults) ─────────────────────
DATABASE_URL=postgresql+asyncpg://agentfleet:agentfleet@localhost:5432/agentfleet
REDIS_URL=redis://localhost:6379/0
# How mission runs execute: "inprocess" (default — asyncio task in the API
# process; simplest for local dev, but a run dies if the API restarts) or
# "arq" (durable — enqueued to the Redis-backed arq worker; set this to
# "arq" together with the `worker` service for durable runs).
# ORCHESTRATOR_MODE=inprocess
# Which LangGraph checkpointer backs agent graph state: "postgres" (default,
# durable across restarts/replicas — uses the same DB as DATABASE_URL, via
# psycopg) or "memory" (in-process only, for a DB-less dev laptop). Also
# falls back to memory automatically if Postgres init fails.
# CHECKPOINTER=postgres

# ── LLM providers ───────────────────────────────────────────────────────────
# Dev/testing: freellmapi proxy — OpenAI-compatible endpoint over 11 free
# providers with quota fallthrough. Key lives in your career-ops repo.
FREE_LLM_BASE_URL=http://localhost:3001/v1
FREE_LLM_KEY=paste-your-freellmapi-key-here
# Default model for tool-calling agents (browse http://localhost:3001/v1/models)
DEFAULT_MODEL=openai/gpt-oss-120b
# Tiered routing: the Orchestrator's PLANNING call may use a stronger "brain"
# model while task executors stay on the cheap default. Empty = use default.
# PLANNER_MODEL=

# Demos/recordings: paid path, switched via env — optional during dev
# ANTHROPIC_API_KEY=

# ── Observability (Langfuse cloud free tier — wired in P2) ─────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Web search (SearXNG from docker compose) ───────────────────────────────
SEARXNG_URL=http://localhost:8081
# Provider to try first for web_search: "tavily" | "exa" | "searxng".
# Leave blank/"searxng" to use only the local SearXNG container.
# WEB_SEARCH_PROVIDER=searxng
# Tavily: https://tavily.com — free tier, 1000 searches/mo
# TAVILY_API_KEY=
# Exa: https://exa.ai — neural search API
# EXA_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API. Default matches
# the web app's local dev port; add your deployed web origin(s) in prod.
# CORS_ORIGINS=http://localhost:3002

# ── Auth (Auth.js v5 + Google OAuth) ───────────────────────────────────────
# From Google Cloud console → Credentials → OAuth client ID (Web application)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Random signing secret — generate with: openssl rand -base64 32
# AUTH_SECRET=
# Web app runs on port 3002 (3000 is taken on this machine); register
# http://localhost:3002/api/auth/callback/google in Google console.
# AUTH_URL=http://localhost:3002
# The API verifies this SAME AUTH_SECRET (HS256 JWT) to authenticate /api/v1
# requests once API auth lands (Phase 12). Keep it identical to the web value.

# ── New-agent integrations (Phase 10) — leave blank to disable that agent's
#    external action; the agent still loads, it just won't call the service.
# SLACK_WEBHOOK_URL=      # Competitor Monitor / scheduled-run digests (Slack Incoming Webhook)
# HUBSPOT_ACCESS_TOKEN=   # Meeting-Notes→CRM (HubSpot free private-app token)
# GITHUB_TOKEN=           # optional Code-Reviewer / GitHub agent (read-only PAT)
# ANALYTICS_DATABASE_URL= # SQL Analytics read-only demo DB (defaults to a seeded read-only schema in the main Postgres)
# OPENAI_API_KEY=         # optional: Whisper API for transcription (else local faster-whisper, no key)

# ── Voice agent (Phase 10 N) ───────────────────────────────────────────────
# VAPI_API_KEY=           # Vapi (bundles STT/TTS/telephony); blank = hide the voice agent
# VAPI_PUBLIC_KEY=        # Public key: browser SDK uses this to start a call; blank = /voice shows a "not configured" state (this is what actually gates the feature — VAPI_API_KEY above is reserved for server-side management, unused for now)

# ── Webhooks + scheduled runs (Phase 10 I) ─────────────────────────────────
# WEBHOOK_SIGNING_SECRET= # HMAC secret to verify inbound webhook triggers

# ── Error monitoring (Phase 11 P) ──────────────────────────────────────────
# SENTRY_DSN=             # FastAPI backend Sentry DSN
# NEXT_PUBLIC_SENTRY_DSN= # Next.js frontend Sentry DSN

# ── Deploy networking (Phase 12 F2 / 13) ───────────────────────────────────
# Web SSR (server-side) reaches the API over the internal network, while the
# browser uses NEXT_PUBLIC_API_URL. Set this in containerized/deployed runs.
# INTERNAL_API_URL=http://api:8000

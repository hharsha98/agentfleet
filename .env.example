# AgentFleet — environment template.
# Copy to .env and fill in your values:   cp .env.example .env
# .env is gitignored — real keys never get committed.

# ── Database & queue (matches docker compose defaults) ─────────────────────
DATABASE_URL=postgresql+asyncpg://agentfleet:agentfleet@localhost:5432/agentfleet
REDIS_URL=redis://localhost:6379/0

# ── LLM providers ───────────────────────────────────────────────────────────
# Dev/testing: freellmapi proxy — OpenAI-compatible endpoint over 11 free
# providers with quota fallthrough. Key lives in your career-ops repo.
FREE_LLM_BASE_URL=http://localhost:3001/v1
FREE_LLM_KEY=paste-your-freellmapi-key-here
# Default model for tool-calling agents (browse http://localhost:3001/v1/models)
DEFAULT_MODEL=openai/gpt-oss-120b
# Tiered routing: the Orchestrator's PLANNING call may use a stronger "brain"
# model while task executors stay on the cheap default. Empty = use default.
# PLANNER_MODEL=

# Demos/recordings: paid path, switched via env — optional during dev
# ANTHROPIC_API_KEY=

# ── Observability (Langfuse cloud free tier — wired in P2) ─────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Web search (SearXNG from docker compose) ───────────────────────────────
SEARXNG_URL=http://localhost:8081

# ── Auth (Auth.js v5 + Google OAuth) ───────────────────────────────────────
# From Google Cloud console → Credentials → OAuth client ID (Web application)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Random signing secret — generate with: openssl rand -base64 32
# AUTH_SECRET=
# Web app runs on port 3002 (3000 is taken on this machine); register
# http://localhost:3002/api/auth/callback/google in Google console.
# AUTH_URL=http://localhost:3002

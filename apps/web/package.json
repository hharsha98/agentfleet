{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "e2e": "playwright test",
    "e2e:fast": "E2E_SKIP_LLM=1 playwright test",
    "cf:build": "OPEN_NEXT=1 opennextjs-cloudflare build",
    "cf:preview": "OPEN_NEXT=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "OPEN_NEXT=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false .wrangler/cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@sentry/nextjs": "^10.65.0",
    "@vapi-ai/web": "^2.6.1",
    "@xyflow/react": "12.12.0",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vega": "^5.33.1",
    "vega-embed": "^6.29.0",
    "vega-lite": "^5.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.128.0"
  }
}
